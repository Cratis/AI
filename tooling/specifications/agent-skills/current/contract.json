        "type": "string"
      },
      "compatibility": {
        "type": "string",
        "minimumCharacters": 1,
        "maximumCharacters": 500
      },
      "metadata": {
        "type": "string-to-string-map"
      },
      "allowed-tools": {
        "type": "string",
        "experimental": true,
        "universalMode": "accepted",
        "cratisPassiveMode": "forbidden"
      }
    }
  },
  "parserPolicy": {
    "format": "bounded-closed-yaml-frontmatter",
    "lineEndings": ["LF", "CRLF"],
