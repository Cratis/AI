{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "ask": [
            "Bash(git push:*)",
            "Bash(rtk git push:*)",
            "Bash(gh pr create:*)",
            "Bash(rtk gh pr create:*)",
            "Bash(gh pr merge:*)",
            "Bash(rtk gh pr merge:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(**/.env)",
            "Read(**/.env.*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.ai/hooks/scripts/cratis-guard-writes.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.ai/hooks/scripts/cratis-pattern-scan.sh",
                        "timeout": 15
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.ai/hooks/scripts/cratis-quality-gate.sh",
                        "timeout": 900
                    }
                ]
            }
        ]
    }
}
