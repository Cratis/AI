{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/catalog/schemas/mcp-guidance-products.schema.json",
  "title": "Cratis passive MCP guidance products",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "path": { "type": "string", "minLength": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "classificationPath", "classificationSchemaPath", "skillRoot", "observationalReferencePath", "blockedReferencePath", "componentId", "sourceContractId", "profileIds", "privateImplementationFactsAllowed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "classificationPath": { "$ref": "#/$defs/path" },
        "classificationSchemaPath": { "$ref": "#/$defs/path" },
        "skillRoot": { "$ref": "#/$defs/path" },
        "observationalReferencePath": { "$ref": "#/$defs/path" },
        "blockedReferencePath": { "$ref": "#/$defs/path" },
        "componentId": { "$ref": "#/$defs/id" },
        "sourceContractId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "profileIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "privateImplementationFactsAllowed": { "const": false }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultPolicy", "products"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultPolicy": { "const": "deny" },
    "products": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/product" } }
  }
}
