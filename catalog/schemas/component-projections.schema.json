{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/catalog/schemas/component-projections.schema.json",
  "title": "Cratis authored component projection catalog",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "kind": { "enum": ["skill", "agent", "subagent", "command", "prompt", "rule", "instruction", "hook", "mcp", "lsp", "executable-host-extension", "static-asset"] },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "hostAdapterId", "materialization", "staticOutputRoot", "acceptsAnyPassiveProjection", "allowedProjectedKinds", "allowedOutputPrefixes", "sharedSymlinkOutputs", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "contract": { "enum": ["claude-code", "codex", "github-copilot", "pi", "portable-agent-plugins-1-0", "jetbrains-ai-assistant", "tabnine", "visual-studio-copilot", "devin-hosted"] },
        "hostAdapterId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "materialization": { "enum": ["repository-existing", "static-fixture", "none"] },
        "staticOutputRoot": { "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
        "acceptsAnyPassiveProjection": { "type": "boolean" },
        "allowedProjectedKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/kind" } },
        "allowedOutputPrefixes": { "$ref": "#/$defs/stringArray" },
        "sharedSymlinkOutputs": { "$ref": "#/$defs/stringArray" },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "hostId", "projectedKind", "artifactClass", "assuranceProfileId", "packageIdentity", "state", "hostActivation", "adapterType", "outputPaths", "approval", "evidenceIds", "securityRequirements", "requiredCanaries"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "componentId": { "$ref": "#/$defs/id" },
        "hostId": { "$ref": "#/$defs/id" },
        "projectedKind": { "$ref": "#/$defs/kind" },
        "artifactClass": { "$ref": "#/$defs/id" },
        "assuranceProfileId": { "$ref": "#/$defs/id" },
        "packageIdentity": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "state": { "enum": ["planned", "blocked", "existing", "generated-static"] },
        "hostActivation": { "enum": ["active", "inert", "none"] },
        "adapterType": { "enum": ["symlink", "path-reference", "canonical-in-place", "generated", "none"] },
        "outputPaths": { "$ref": "#/$defs/stringArray" },
        "approval": { "enum": ["modeled", "approved", "blocked"] },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "securityRequirements": { "$ref": "#/$defs/idArray" },
        "requiredCanaries": { "$ref": "#/$defs/idArray" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultPolicy", "supportClaim", "hosts", "projections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultPolicy": { "const": "deny" },
    "supportClaim": { "const": false },
    "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/host" } },
    "projections": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/projection" } }
  }
}
