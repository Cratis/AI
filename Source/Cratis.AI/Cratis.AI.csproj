<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Chronicle's DefaultClientArtifactsProvider discovers package-referenced assemblies whose
             name starts with "Cratis" (Cratis.Fundamentals.Types.PackageReferencedAssemblies) - the
             assembly name is therefore load-bearing, not cosmetic. See
             AI-consolidation-plan.md risk #11 and Section 12.2. Do not rename without also fixing discovery. -->
        <AssemblyName>Cratis.AI</AssemblyName>
        <RootNamespace>Cratis.AI</RootNamespace>
        <Description>Backend AI concerns for Cratis products - providers, pools, tiers, concurrency, conversations, agents, worker/harness scheduling and usage - one source of truth shared by Direct and Studio.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cratis.AI.Specs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
        <!-- Commands, read models, concepts and their validators (ConceptValidator, [Command], [ReadModel] etc). -->
        <PackageReference Include="Cratis.Arc.Core" />
        <!-- Read models are stored in MongoDB collections read directly for on-demand aggregation (AgentUsageByWeek/Month). -->
        <PackageReference Include="Cratis.Arc.MongoDB" />
        <!-- Chronicle is referenced directly, not transitively through Cratis.Arc.Chronicle, so central
             package management actually pins the client version (plan Section 5.3f). -->
        <PackageReference Include="Cratis.Chronicle" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <!-- Worker/agent scheduling (Docker + Kubernetes runtimes). -->
        <PackageReference Include="KubernetesClient" />
        <PackageReference Include="Docker.DotNet.Enhanced" />
    </ItemGroup>
</Project>
