<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <!-- Cratis / Arc family. Aligned on the higher of the two donor repositories' versions
             (Studio was ahead of Direct at investigation time - see AI-consolidation-plan.md §2.5,
             risk #6). Both Direct and Studio must be bumped onto this set as part of migration. -->
        <PackageVersion Include="Cratis" Version="22.14.0" />
        <PackageVersion Include="Cratis.Arc" Version="22.14.0" />
        <PackageVersion Include="Cratis.Arc.Core" Version="22.14.0" />
        <PackageVersion Include="Cratis.Arc.ProxyGenerator.Build" Version="22.14.0" />
        <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="22.14.0" />
        <PackageVersion Include="Cratis.Arc.OpenApi" Version="22.14.0" />
        <PackageVersion Include="Cratis.Arc.MongoDB" Version="22.14.0" />

        <!-- Chronicle - referenced directly (not transitively through Cratis.Arc.Chronicle) so central
             package management actually pins the client version. See AI-consolidation-plan.md §5.3f. -->
        <PackageVersion Include="Cratis.Chronicle" Version="18.1.6" />
        <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="18.1.6" />
        <PackageVersion Include="Cratis.Chronicle.Contracts" Version="18.1.6" />
        <PackageVersion Include="Cratis.Chronicle.Testing" Version="18.1.6" />
        <PackageVersion Include="Cratis.Chronicle.XUnit.Integration" Version="18.1.6" />

        <PackageVersion Include="Cratis.Fundamentals" Version="7.19.2" />

        <PackageVersion Include="Cratis.Specifications" Version="4.1.0" />
        <PackageVersion Include="Cratis.Specifications.XUnit" Version="4.1.0" />

        <!-- Conversational / tool-calling stack (from Studio's ChatClient) -->
        <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
        <PackageVersion Include="Anthropic" Version="12.47.0" />

        <!-- Worker/agent scheduling (Docker + Kubernetes runtimes) -->
        <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
        <PackageVersion Include="KubernetesClient" Version="19.0.2" />

        <!-- Toolset -->
        <PackageVersion Include="System.Text.Json" Version="10.0.11" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.190" />

        <!-- Specs -->
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageVersion Include="NSubstitute" Version="6.2.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    </ItemGroup>
</Project>
