{
  "protocolVersion": "1",
  "algorithm": "factory-canonical-json-v1",
  "contentHash": "sha256:59617733c90b9d57e6ce43e1a3e9563b6ca70cbdae4f79cbbd87d5b0581eafaf",
  "description": "Language-neutral canonical JSON, hashing, and explicit top-level self-hash conformance vectors. This algorithm is not RFC 8785.",
  "limits": {
    "maximumInputBytes": 2000000,
    "maximumOutputBytes": 2000000,
    "maximumDepth": 64,
    "maximumStringScalars": 1000000,
    "maximumKeyScalars": 1000000,
    "maximumStructuralPunctuationTokens": 100000,
    "maximumArrayItems": 99999,
    "maximumObjectMembers": 49999
  },
  "generatorContract": {
    "repeatedString": "A JSON string containing scalar repeated scalarCount times.",
    "singlePropertyObject": "An object whose only key contains keyScalar repeated keyScalarCount times and whose value is null.",
    "arrayOfNulls": "An array containing count null values.",
    "objectWithNullMembers": "An object containing count null-valued members named by keyPrefix followed by a zero-padded base-10 index of keyDigits digits.",
    "nestedArrays": "depth arrays enclosing a null leaf; the root array has depth one.",
    "paddedValue": "leadingWhitespaceCount ASCII spaces followed by valueBase64.",
    "twoStringObject": "An object with keys a and b whose values repeat their corresponding scalar the specified number of times.",
    "selfHashObject": "An object with a payload string of payloadScalarCount repetitions; the named top-level hash field is absent for calculation.",
    "objectWithOneEmptyObjectMember": "The objectWithNullMembers form, except index zero has an empty-object value.",
    "arrayWithOneEmptyArrayItem": "An array containing count items; index zero is an empty array and every other item is null."
  },
  "cases": [
