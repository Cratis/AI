+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+// Hand-written gap-fill: the shelving rules compare against a calendar date, which the model cannot express.
+namespace Library.Shelving;
+
+public static class ShelfRules
+{
+    /// <summary>The number of days a returned book waits before it is shelved.</summary>
+    public const int ShelveAfterDays = 2;
+
+    /// <summary>Gets the number of books one shelf holds.</summary>
+    public static int Capacity => ShelfCapacity.Resolve();
+
+    /// <summary>Whether a book can be reserved.</summary>
+    public static bool IsReservable(Book book) => !book.IsRetired && book.Copies > 0;
+
+    /// <summary>Whether a returned book is ready for its shelf.</summary>
+    public static bool IsShelfReady(Book book)
+    {
+        return book.ReturnedOn.AddDays(ShelveAfterDays) <= Today;
+    }
+
+    /// <summary>Whether a book needs a condition review.</summary>
+    public static bool NeedsReview(Book book) => book.Loans >= 25;
+
+    /// <summary>Narrows a collection with a rule.</summary>
+    public static IEnumerable<T> Where<T>(IEnumerable<T> source, Func<T, bool> rule) =>
+        source.Where(rule).ToArray();
+}
