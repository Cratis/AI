+// Copyright (c) Cratis. All rights reserved.
+// Licensed under the MIT license. See LICENSE file in the project root for full license information.
+
+// Hand-written gap-fill: the Today rules from SPEC S1 compare against "today", which the Screenplay
+// executable subset cannot express (`today` and $context date comparisons are PLAY0268). The model
+// declares the OverdueTasks, TasksDueToday and DormantOpportunities queries; these rules narrow them.
+using System.Reactive.Linq;
+using System.Reactive.Subjects;
+using SoloCrm.Common;
+using SoloCrm.Crm.Opportunities.Pipeline;
+using SoloCrm.Crm.Tasks.Tasks;
+
+namespace SoloCrm.Crm.Today;
+
+/// <summary>
+/// The date rules behind the Today view, evaluated in the configured time zone (default Europe/Berlin).
+/// </summary>
+public static class TodayRules
+{
+    /// <summary>The number of calendar days without activity after which an open opportunity is dormant.</summary>
+    public const int DormantAfterDays = 7;
+
+    static readonly TimeZoneInfo _timeZone = ResolveTimeZone();
+
+    /// <summary>Gets today's date in the configured time zone.</summary>
+    public static DateOnly Today => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, _timeZone).DateTime);
+
+    /// <summary>Whether a task is open and due before today.</summary>
+    /// <param name="task">The task.</param>
+    /// <returns>True when overdue.</returns>
+    public static bool IsOverdue(TaskItem task) => !task.IsCompleted && task.DueDate < Today;
+
+    /// <summary>Whether a task is open and due today.</summary>
+    /// <param name="task">The task.</param>
+    /// <returns>True when due today.</returns>
+    public static bool IsDueToday(TaskItem task) => !task.IsCompleted && task.DueDate == Today;
+
+    /// <summary>Whether an opportunity is open, not archived and has had no activity for the threshold.</summary>
+    /// <param name="opportunity">The opportunity.</param>
+    /// <returns>True when dormant.</returns>
+    public static bool IsDormant(Opportunity opportunity)
+    {
+        if (opportunity.IsArchived || (opportunity.StageStatus is not null && opportunity.StageStatus != StageStatus.Open))
+        {
+            return false;
+        }
+
+        var lastTouched = opportunity.ReceivedOn;
+        if (opportunity.LastActivityAt is { } lastActivity)
+        {
+            var activityDay = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(lastActivity, _timeZone).DateTime);
+            if (activityDay > lastTouched)
+            {
+                lastTouched = activityDay;
+            }
+        }
+
+        return lastTouched.AddDays(DormantAfterDays) <= Today;
+    }
+
+    /// <summary>Narrows an observed collection with a rule, keeping it observable.</summary>
+    /// <typeparam name="T">The read model type.</typeparam>
+    /// <param name="source">The observed collection.</param>
+    /// <param name="rule">The rule an item must satisfy.</param>
+    /// <returns>A subject producing only the matching items.</returns>
+    public static ISubject<IEnumerable<T>> Where<T>(ISubject<IEnumerable<T>> source, Func<T, bool> rule) =>
+        System.Reactive.Subjects.Subject.Create<IEnumerable<T>>(source, source.Select(items => items.Where(rule).ToArray()));
+
+    static TimeZoneInfo ResolveTimeZone()
+    {
+        var id = Environment.GetEnvironmentVariable("App__TimeZone") ?? "Europe/Berlin";
+        return TimeZoneInfo.TryFindSystemTimeZoneById(id, out var zone) ? zone : TimeZoneInfo.Utc;
+    }
+}
