{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cratis.io/factory/v1/policy.schema.json",
  "title": "Cratis Factory Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentKind",
    "id",
    "version",
    "defaultDecision",
    "protectedPaths",
    "deniedCratisCommands",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "documentKind": {
      "const": "policy"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "defaultDecision": {
      "const": "deny"
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deniedCratisCommands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": ["allow", "approval", "deny"]
      }
    }
  }
}
