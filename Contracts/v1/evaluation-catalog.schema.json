{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cratis.io/factory/v1/evaluation-catalog.schema.json",
  "title": "Cratis Factory Evaluation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentKind", "version", "fixtures", "executions", "cases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "documentKind": {
      "const": "evaluation-catalog"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "profile",
          "objective",
          "classification",
          "expectedInvariants",
          "forbiddenOutcomes",
          "requiredEvidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "category": {
            "enum": [
              "application",
              "client",
              "framework",
              "modeling",
              "operations",
              "reliability",
              "security"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": ["public", "internal", "confidential", "restricted"]
          },
          "expectedInvariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbiddenOutcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "treeHash", "contentHash"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "const": "repository-tree"
        },
        "path": {
          "type": "string",
          "pattern": "^Factory/Fixtures/Ecosystems/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "treeHash": {
          "$ref": "#/$defs/contentHash"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "caseId",
        "kind",
        "fixtureId",
        "request",
        "expectedProfileIds",
        "assertions",
        "contentHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "caseId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["resolve", "preflight"]
        },
        "fixtureId": {
          "$ref": "#/$defs/identifier"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetPath", "purpose"],
          "properties": {
            "targetPath": {
              "type": "string",
              "minLength": 1
            },
            "purpose": {
              "$ref": "#/$defs/identifier"
            },
            "workflow": {
              "$ref": "#/$defs/identifier"
            },
            "policy": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "expectedProfileIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "operator", "expected"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"
        },
        "operator": {
          "enum": ["equals", "contains", "not-contains", "project-contains", "project-set-equals"]
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "expected": {
          "$ref": "#/$defs/canonicalValue"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["project-contains", "project-set-equals"]
              }
            }
          },
          "then": {
            "required": ["field"]
          },
          "else": {
            "not": {
              "required": ["field"]
            }
          }
        }
      ]
    },
    "canonicalValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/canonicalValue" }
        }
      ]
    }
  }
}
