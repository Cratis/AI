<Project>
  <PropertyGroup><TargetFramework>net11.0</TargetFramework><IsTestProject>true</IsTestProject><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Cratis.Arc" Version="24.9.0"/><PackageReference Include="Cratis.Arc.Testing" Version="24.9.0"/>
    <PackageReference Include="Cratis.Fundamentals" Version="7.34.5"/><PackageReference Include="Cratis.Specifications.XUnit.v3" Version="5.3.0"/>
    <PackageReference Include="xunit.v3" Version="4.0.2"/><PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/><PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all"/>
  </ItemGroup>
</Project>
