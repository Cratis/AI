    <PackageVersion Include="Cratis.Arc.Swagger" Version="24.9.0" />
    <PackageVersion Include="Cratis.Arc.Chronicle" Version="24.9.0" />
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="24.9.0" />
    <PackageVersion Include="Cratis.Chronicle" Version="19.184.3" />
    <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="19.184.3" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.184.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
