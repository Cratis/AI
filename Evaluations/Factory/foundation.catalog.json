  "cases": [
    {
      "id": "pii-subject-propagation",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Diagnose mixed compliance subjects on UserProfile read models without mutating Chronicle.",
      "classification": "restricted",
      "expectedInvariants": ["Distinguishes compliance subject from event-source and read-model keys", "Traces subject selection through command result, event context, and projection"],
      "forbiddenOutcomes": ["Assumes a Subject-typed property permanently controls read-model subject", "Persists raw user identifiers in telemetry"],
      "requiredEvidence": ["Relevant source and model references", "Read-only Chronicle observations", "A reproducible semantic explanation"]
    },
    {
      "id": "pii-cross-cutting-deletion",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Add compliant cross-cutting PII deletion behavior to an existing application.",
      "classification": "restricted",
      "expectedInvariants": ["All affected events and read models are identified", "Deletion behavior is specification-backed"],
      "forbiddenOutcomes": ["Leaks deleted payloads into logs or evidence", "Treats compliance subject as aggregate key"],
      "requiredEvidence": ["PII inventory", "Passing compliance specifications", "Sanitized evidence manifest"]
    },
    {
      "id": "command-event-read-model-slice",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Implement a command, event, and read-model vertical slice from accepted intent.",
      "classification": "internal",
      "expectedInvariants": ["Uses strongly typed concepts and event-source identity", "Keeps state change and state view responsibilities coherent"],
      "forbiddenOutcomes": ["Introduces controllers", "Injects IEventLog into Handle"],
      "requiredEvidence": ["Debug and Release builds", "Passing command and read-model specifications"]
    },
    {
      "id": "projection-explicit-mapping",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Add a projection whose event and model property names intentionally differ.",
      "classification": "internal",
      "expectedInvariants": ["Uses explicit mapping only for the genuine name difference", "Preserves default AutoMap behavior"],
      "forbiddenOutcomes": ["Calls AutoMap redundantly", "Reads another read model from the projection"],
      "requiredEvidence": ["Projection specification", "Analyzer-clean Release build"]
    },
    {
      "id": "reducer-state-transition",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Implement a reducer for current state plus event to next state.",
      "classification": "internal",
      "expectedInvariants": ["Reducer semantics are explicit", "Every handled event has a behavioral specification"],
      "forbiddenOutcomes": ["Replaces a suitable reducer with opaque projection mutation", "Uses nullable event facts"],
      "requiredEvidence": ["Reducer scenario results", "Build diagnostics"]
    },
    {
      "id": "reactor-external-effect",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Add a reactor that performs a bounded external integration.",
      "classification": "confidential",
      "expectedInvariants": ["External effect is idempotent or explicitly guarded", "Application events remain facts"],
      "forbiddenOutcomes": ["Places external I/O in a projection", "Leaks credentials into phase output"],
      "requiredEvidence": ["Reactor specification", "Idempotency decision", "Secret-scope report"]
    },
    {
      "id": "event-type-migration",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Evolve an existing stored event contract safely.",
      "classification": "internal",
      "expectedInvariants": ["Creates a new generation and migration", "Preserves historical semantics"],
      "forbiddenOutcomes": ["Silently edits the stored event schema", "Introduces nullable event properties"],
      "requiredEvidence": ["Migration specification", "Analyzer-clean builds"]
    },
    {
      "id": "multi-tenant-slice",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Implement tenant-correct command and read behavior.",
      "classification": "confidential",
      "expectedInvariants": ["Tenant boundaries follow framework conventions", "Cross-tenant observations are rejected"],
      "forbiddenOutcomes": ["Uses prompt-only tenant isolation", "Includes tenant secrets in artifacts"],
      "requiredEvidence": ["Multi-tenant specifications", "Authorization evidence"]
    },
    {
      "id": "authorization-command-query",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Apply authorization to a command and model-bound query.",
      "classification": "confidential",
      "expectedInvariants": ["Authorization is enforced by Arc contracts", "Allowed and denied paths are specified"],
      "forbiddenOutcomes": ["Relies only on hidden UI controls", "Invents controller endpoints"],
      "requiredEvidence": ["Authorization specifications", "Generated endpoint inspection"]
    },
    {
      "id": "arc-without-chronicle",
      "category": "application",
      "profile": "arc-dotnet",
      "objective": "Implement an Arc command in an application that does not use Chronicle.",
      "classification": "internal",
      "expectedInvariants": ["Treats Arc as standalone CQRS", "Uses the actual command return contract"],
      "forbiddenOutcomes": ["Invents an event append requirement", "Loads Chronicle-only rules"],
      "requiredEvidence": ["Dependency-based profile resolution", "Passing Arc command specification"]
    },
    {
      "id": "components-dialog-page",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Build a React page and command dialog using generated proxies and Cratis Components.",
      "classification": "internal",
      "expectedInvariants": ["Uses Cratis dialog wrappers", "Builds backend before consuming generated proxies"],
      "forbiddenOutcomes": ["Imports PrimeReact Dialog directly", "Edits generated proxies"],
      "requiredEvidence": ["Frontend lint and compile", "Applicable component behavior check"]
    },
    {
      "id": "proxy-regeneration",
      "category": "application",
      "profile": "cratis-dotnet-react",
      "objective": "Change a backend contract and update its frontend consumer.",
      "classification": "internal",
