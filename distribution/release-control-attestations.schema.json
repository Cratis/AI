{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/distribution/release-control-attestations.schema.json",
  "title": "Cratis external release-control attestations",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "controlId", "issuer", "authority", "subjectKind", "subject", "scope", "observedOn", "validThrough", "evidenceDigest", "status", "revocationSource", "revocationCheckedOn", "issuerIdentity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "controlId": { "$ref": "#/$defs/id" },
        "issuer": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "subjectKind": { "enum": ["repository", "branch", "workflow", "environment", "package", "marketplace-account"] },
        "subject": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "observedOn": { "type": "string", "format": "date" },
        "validThrough": { "type": "string", "format": "date" },
        "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["active", "expired", "revoked", "blocked"] },
        "revocationSource": { "type": "string", "minLength": 1 },
        "revocationCheckedOn": { "type": "string", "format": "date" },
        "issuerIdentity": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultPolicy", "attestations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultPolicy": { "const": "deny" },
    "attestations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/attestation" } }
  }
}
