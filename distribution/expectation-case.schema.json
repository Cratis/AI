{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/blob/main/distribution/expectation-case.schema.json",
  "title": "Cratis AI typed expectation case",
  "description": "One case per behavior for a skill evaluation: what triggers the skill, what is asserted, and what outcome is expected. Mechanical fields are provable from a host trace per Documentation/evaluation-evidence-protocol.md; judged fields are recorded as judged. A case set that opts in to this schema is validated by validate-catalogs --basic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "evaluatedSkillRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "caseKind",
          "coverage",
          "prompt",
          "trigger",
          "assertions",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "caseKind": {
            "enum": ["positive", "negative", "adversarial"]
          },
          "coverage": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "fixtureRef": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-./][a-z0-9]+)*$"
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "shouldTrigger"],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "shouldTrigger": {
                "type": "boolean"
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "statement"],
              "properties": {
                "kind": {
                  "enum": ["functional", "structural", "disclosure", "negative", "verification"]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "mechanical": {
                  "type": "boolean",
                  "description": "True when a host trace proves or refutes this assertion per the evidence protocol; false when it stays human-judged."
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "activation",
              "disposition",
              "requiredOutcome"
            ],
            "properties": {
              "activation": {
                "enum": [
                  "skill-activates",
                  "skill-does-not-activate",
                  "not-observable"
                ]
              },
              "disposition": {
                "enum": [
                  "completes",
                  "refuses",
                  "asks",
                  "not-observable"
                ]
              },
              "preserve": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prohibitedEffects": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requiredOutcome": {
                "type": "string",
                "minLength": 1
              },
              "forbiddenOutputLiterals": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
