{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/distribution/release-record.schema.json",
  "title": "Append-only Cratis release record",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "recordId", "releaseVersion", "artifactDigest", "requestDigest", "preflightDigest", "sourceRevision", "evidenceIds", "previousRecordIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stage": { "enum": ["preflight-snapshot", "release-request", "authorized-candidate", "publication-receipt", "promotion-receipt", "support-approval"] },
    "recordId": { "$ref": "#/$defs/id" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "artifactDigest": { "$ref": "#/$defs/sha256" },
    "requestDigest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "preflightDigest": { "$ref": "#/$defs/sha256" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "previousRecordIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
