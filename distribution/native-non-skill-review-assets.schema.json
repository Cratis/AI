{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/distribution/native-non-skill-review-assets.schema.json",
  "title": "Cratis native non-skill review assets manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "schemaPath", "schemaSha256", "state", "version", "sourceRepository", "sourceCommit", "generatedBy", "rootCount", "projectedFileCount", "projectedComponentCount", "componentExclusions", "assets", "projectionReceiptPath", "projectionReceiptSha256", "componentCoveragePath", "componentCoverageSha256", "approvalEligible", "installationSupported", "packageIdentity", "publicationEligible", "runtimeEligible", "supportGranted", "promotionEligible"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "schemaPath": { "const": "distribution/native-non-skill-review-assets.schema.json" },
    "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state": { "const": "NATIVE_NON_SKILL_REVIEW_ONLY" },
    "version": { "type": "string", "pattern": "^0\\.0\\.(?:0|[1-9][0-9]*)-candidate\\.(?:0|[1-9][0-9]*)$" },
    "sourceRepository": { "const": "https://github.com/Cratis/AI" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedBy": { "const": "tooling/package-native-non-skill-review-assets.mjs" },
    "rootCount": { "const": 4 },
    "projectedFileCount": { "const": 70 },
    "projectedComponentCount": { "const": 35 },
    "componentExclusions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "kind", "reason"],
        "properties": {
          "componentId": { "enum": ["cratis-rule-github-actions", "cratis-rule-local-work-artifacts"] },
          "kind": { "const": "rule" },
          "reason": { "const": "no-generated-static-contract" }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rootId", "filename", "format", "fileCount", "size", "sha256", "packageIdentity", "hostActivation"],
        "properties": {
          "rootId": { "enum": ["devin-hosted-instructions", "jetbrains-ai-assistant-rules", "tabnine-guidelines", "visual-studio-copilot-instructions"] },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tar\\.gz$" },
          "format": { "const": "tar+gzip" },
          "fileCount": { "type": "integer", "minimum": 1 },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "packageIdentity": { "type": "null" },
          "hostActivation": { "const": "none" }
        }
      }
    },
    "projectionReceiptPath": { "const": "projection-receipt.json" },
    "projectionReceiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentCoveragePath": { "const": "component-coverage.json" },
    "componentCoverageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvalEligible": { "const": false },
    "installationSupported": { "const": false },
    "packageIdentity": { "type": "null" },
    "publicationEligible": { "const": false },
    "runtimeEligible": { "const": false },
    "supportGranted": { "const": false },
    "promotionEligible": { "const": false }
  }
}
