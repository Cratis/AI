{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/distribution/candidate-component-coverage.schema.json",
  "title": "Cratis candidate component coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaPath",
    "schemaSha256",
    "state",
    "inputDigests",
    "componentCount",
    "byKind",
    "byDisposition",
    "records",
    "approvalGranted",
    "installationSupported",
    "publicationEligible",
    "runtimeEligible",
    "supportGranted",
    "promotionEligible"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "schemaPath": { "const": "distribution/candidate-component-coverage.schema.json" },
    "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state": { "const": "CANDIDATE_COMPONENT_COVERAGE_REVIEW_ONLY" },
    "inputDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "projections", "artifacts"],
      "properties": {
        "components": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "projections": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifacts": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "componentCount": { "const": 137 },
    "byKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "command", "executable-host-extension", "hook", "instruction", "prompt", "rule", "skill"],
      "properties": {
        "agent": { "const": 12 },
        "command": { "const": 18 },
        "executable-host-extension": { "const": 2 },
        "hook": { "const": 1 },
        "instruction": { "const": 1 },
        "prompt": { "const": 18 },
        "rule": { "const": 36 },
        "skill": { "const": 49 }
      }
    },
    "byDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable-blocked",
        "native-static-review-projected",
        "native-static-unprojected",
        "repository-host-adapter-only",
        "skill-blocked-candidate",
        "skill-legacy-repository-only",
        "skill-packaged-candidate"
      ],
      "properties": {
        "executable-blocked": { "const": 3 },
        "native-static-review-projected": { "const": 35 },
        "native-static-unprojected": { "const": 2 },
        "repository-host-adapter-only": { "const": 48 },
        "skill-blocked-candidate": { "const": 4 },
        "skill-legacy-repository-only": { "const": 4 },
        "skill-packaged-candidate": { "const": 41 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 137,
      "maxItems": 137,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "kind",
          "audience",
          "lifecycle",
          "releaseBoundary",
          "disposition",
          "reason",
          "existingProjectionCount",
          "generatedStaticProjectionCount",
          "approvalState",
          "runtimeEligible",
          "publicationEligible",
          "supportGranted"
        ],
        "properties": {
          "componentId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["agent", "command", "executable-host-extension", "hook", "instruction", "prompt", "rule", "skill"] },
          "audience": { "enum": ["public", "cratis-engineering"] },
          "lifecycle": { "enum": ["active", "legacy-retained"] },
          "releaseBoundary": { "enum": ["public-passive", "engineering-passive", "repository-only", "future-executable-package"] },
          "disposition": { "enum": ["skill-packaged-candidate", "skill-blocked-candidate", "skill-legacy-repository-only", "native-static-review-projected", "native-static-unprojected", "repository-host-adapter-only", "executable-blocked"] },
          "reason": { "enum": ["included-in-passive-review-candidate", "private-or-local-content", "mcp-guidance-materialization-blocked", "legacy-retained-repository-only", "generated-static-repository-fixture", "no-generated-static-contract", "repository-native-kind-no-package-contract", "executable-component-blocked"] },
          "existingProjectionCount": { "type": "integer", "minimum": 0 },
          "generatedStaticProjectionCount": { "type": "integer", "minimum": 0 },
          "approvalState": { "enum": ["modeled", "blocked"] },
          "runtimeEligible": { "const": false },
          "publicationEligible": { "const": false },
          "supportGranted": { "const": false }
        }
      }
    },
    "approvalGranted": { "const": false },
    "installationSupported": { "const": false },
    "publicationEligible": { "const": false },
    "runtimeEligible": { "const": false },
    "supportGranted": { "const": false },
    "promotionEligible": { "const": false }
  }
}
