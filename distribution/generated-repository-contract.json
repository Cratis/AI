{
  "schemaVersion": "1.0.0",
  "supersedingDecision": {
    "state": "GENERATED_DISTRIBUTION_RETIRED",
    "issue": "https://github.com/Cratis/AI/issues/264",
    "amends": "https://github.com/Cratis/AI/issues/173",
    "decision": "Cratis/AI is installed directly from its default branch. The generated-distribution model — a second repository, then a protected distribution branch with dist/vX.Y.Z tags, a staged generated tree, checksums, provenance, and a mirrored verification control plane — is retired in full. Four committed marketplace manifests resolve the real skills/ and engineering/ directories on main, and they are the entire distribution surface. Cratis/AI.Distribution's published v0.1.0 through v0.3.0 tags are never deleted.",
    "everyFieldBelowStillDescribesTodaysPipeline": false,
    "note": "The fields below describe the retired two-repository model and no workflow reads them any more. They are kept as the record of what was built and published, not as a description of how anything is distributed today. Whether they should be removed with the rest of the assurance data model is a separate decision.",
    "retired": [
      ".github/workflows/publish.yml",
      ".github/workflows/verify-distribution-branch.yml",
      ".github/workflows/distribution-generated-update.yml",
      ".github/workflows/distribution-approved-profile-release.yml",
      ".github/workflows/release-approved-ai-profiles.yml",
      "distribution/repository-control-plane",
      "tooling/generate-public-marketplace-distribution.mjs",
      "tooling/stage-public-marketplace-repository.mjs",
      "tooling/package-public-marketplace-submissions.mjs",
      "tooling/generate-marketplace-pointer-manifests.mjs"
    ],
    "installedFrom": {
      "repository": "Cratis/AI",
      "ref": "default branch",
      "pluginPaths": ["skills", "engineering"],
      "manifests": [
        ".agents/plugins/marketplace.json",
        ".claude-plugin/marketplace.json",
        ".cursor-plugin/marketplace.json",
        ".github/plugin/marketplace.json"
      ]
    },
    "maintainerRunbook": "Documentation/maintainer-marketplace-deployment-runbook.md"
  },
  "repository": {
    "name": "Cratis/AI.Distribution",
    "visibility": "PUBLIC",
    "defaultBranch": "main",
    "status": "INITIALIZED_PROTECTED_FIXTURE",
    "manualAuthoringAllowed": false,
    "botOnlyWrites": true,
    "url": "https://github.com/Cratis/AI.Distribution",
    "strategyIssue": "https://github.com/Cratis/Strategy/issues/126",
    "deployKeySecret": null,
    "initializationState": "COMPLETE_PROTECTED",
    "writeCredentialState": "ABSENT_PENDING_PR_RELEASE_BOT"
  },
  "repositoryReviewCandidates": {
    "root": "candidates",
    "artifactIds": [
      "candidate-passive-engineering-package",
      "candidate-passive-public-package"
    ],
    "versionPattern": "^0\\.0\\.(?:0|[1-9][0-9]*)-candidate\\.(?:0|[1-9][0-9]*)$",
    "preserveDuringPayloadReplacement": true,
    "releaseEligible": false
  },
  "publicEvaluationMarketplace": {
    "enabled": true,
    "profileId": "public-cratis-ai",
    "packageName": "@cratis/ai",
    "piDistribution": "git-only-private-manifest",
    "versionPattern": "^0\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
    "sourceArtifactId": "candidate-passive-public-package",
    "targetCount": 29,
    "selfHostedChannels": [
      "agent-skills",
      "agent-plugin",
      "claude-code",
      "github-copilot",
      "gemini-cli",
      "kiro",
      "pi-git-package"
    ],
    "vendorPortalHandoffs": [
      "openai-skills-only-plugin",
      "cursor-agent-plugin"
    ],
    "publicationEligible": true,
    "installationSupported": false,
    "supportGranted": false,
    "promotionEligible": false
  },
  "localSimulation": {
    "enabled": true,
    "identity": {
      "name": "cratis-distribution-fixture-bot",
      "email": "fixture-bot@invalid.example"
    },
    "fixedCommitDate": "2000-01-01T00:00:00Z",
    "commitMessage": "Generate fixture distribution"
  },
  "requiredChecks": [
    "exact-inventory",
    "canonical-byte-parity",
    "native-manifest-parse",
    "checksums",
    "fixture-provenance-record",
    "pack-install-smoke-uninstall",
    "canary-rollback-simulation"
  ],
  "protectedEnvironments": [
    "distribution-canary",
    "npm-stage"
  ],
  "forbiddenRepositoryContent": [
