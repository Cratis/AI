{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cratis/AI/distribution/passive-candidate-assets.schema.json",
  "title": "Cratis passive candidate assets manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "schemaPath", "schemaSha256", "state", "artifactId", "audience", "bundleId", "packageName", "version", "sourceCommit", "generatorPaths", "generatorDigest", "componentCatalogSha256", "componentCoveragePath", "componentCoverageSha256", "targetIds", "targetExclusions", "repositoryOnlySkillExclusions", "sourceSkills", "assets", "deterministicReleaseTree", "portableCompliance", "approvalEligible", "installationSupported", "publicationEligible", "runtimeEligible", "supportGranted", "promotionEligible"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "schemaPath": { "const": "distribution/passive-candidate-assets.schema.json" },
    "schemaSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state": { "const": "PASSIVE_CANDIDATE_REVIEW_ONLY" },
    "artifactId": { "enum": ["candidate-passive-public-package", "candidate-passive-engineering-package"] },
    "audience": { "enum": ["public", "cratis-engineering"] },
    "bundleId": { "enum": ["public-all-candidate", "engineering-all-candidate"] },
    "packageName": { "enum": ["@cratis/ai-public-candidate", "@cratis/ai-engineering-candidate"] },
    "version": { "type": "string", "pattern": "^0\\.0\\.(?:0|[1-9][0-9]*)-candidate\\.(?:0|[1-9][0-9]*)$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatorPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "generatorDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentCatalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentCoveragePath": { "const": "candidate-component-coverage.json" },
    "componentCoverageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "targetExclusions": { "$ref": "#/$defs/targetExclusions" },
    "repositoryOnlySkillExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "lifecycle", "sourcePaths", "reason"],
        "properties": {
          "componentId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "lifecycle": { "const": "legacy-retained" },
          "sourcePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "reason": { "const": "legacy-retained-repository-only" }
        }
      }
    },
    "sourceSkills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "sourcePath", "sourceRevision", "contentDigest", "sourceContractPaths", "packagedSourcePaths", "excludedSourcePaths"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "sourcePath": { "type": "string", "minLength": 1 },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceContractPaths": { "$ref": "#/$defs/paths" },
          "packagedSourcePaths": { "$ref": "#/$defs/paths" },
          "excludedSourcePaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/asset" }
    },
    "deterministicReleaseTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "manifestSha256", "assetManifestPath", "assetManifestSha256", "assuranceReceiptPath", "assuranceReceiptSha256"],
      "properties": {
        "manifestPath": { "const": "deterministic-release-manifest.json" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "assetManifestPath": { "const": "candidate-asset-manifest.json" },
        "assetManifestSha256": { "$ref": "#/$defs/sha256" },
        "assuranceReceiptPath": { "const": "artifact-assurance-receipt.json" },
        "assuranceReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "portableCompliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "profileDigest", "specifications", "receiptPath", "receiptSha256", "staticValidationInput", "approvalGranted", "supportGranted", "publicationGranted", "runtimeGranted", "promotionGranted"],
      "properties": {
        "profile": { "const": "cratis-passive-v1" },
        "profileDigest": { "$ref": "#/$defs/sha256" },
        "specifications": { "type": "object" },
        "receiptPath": { "const": "compliance-receipts.json" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "staticValidationInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assuranceId", "outcome", "supporting", "reason"],
          "properties": {
            "assuranceId": { "const": "static-validation" },
            "outcome": { "const": "pass" },
            "supporting": { "const": false },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "approvalGranted": { "const": false },
        "supportGranted": { "const": false },
        "publicationGranted": { "const": false },
        "runtimeGranted": { "const": false },
        "promotionGranted": { "const": false }
      }
    },
    "approvalEligible": { "const": false },
    "installationSupported": { "const": false },
    "publicationEligible": { "const": false },
    "runtimeEligible": { "const": false },
    "supportGranted": { "const": false },
    "promotionEligible": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "targetExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "reason"],
        "properties": {
          "targetId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "reason": { "enum": ["private-or-local-content", "mcp-guidance-materialization-blocked", "incomplete-resource-and-license-closure"] }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "filename", "format", "root", "size", "sha256"],
      "properties": {
        "harness": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(?:tar\\.gz|tgz)$" },
        "format": { "const": "tar+gzip" },
        "root": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
